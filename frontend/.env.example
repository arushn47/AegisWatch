# AegisWatch — Frontend Environment Variables
#
# The live disaster feeds (USGS, NASA EONET, GDACS, NOAA Tsunami) are public
# and work with zero configuration.
#
# Copy this file to .env (which is git-ignored) and fill in your values.
# ─────────────────────────────────────────────────────────────────────────────

# ── REQUIRED: Supabase (auth, user profiles, alert preferences, notifications)
# Get these from: Supabase Dashboard → Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable__your-key-here

# ── REQUIRED: Google OAuth (sign-in with Google)
# Get these from: console.cloud.google.com → Credentials → OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-secret

# ── Web Push Notifications (background OS alerts even when browser tab is closed)
# Generate a new key pair once with: node -e "require('web-push').generateVAPIDKeys()|> console.log(%)"
# Or run: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
# VAPID_SUBJECT: Required by the W3C Web Push spec. Identifies this server to Google/Mozilla
# push relays so they can contact you about abuse. Must be an https:// or mailto: URI.
# Use your Supabase project URL or your own domain. Not shown to end-users.
VAPID_SUBJECT=https://YOUR-PROJECT.supabase.co
